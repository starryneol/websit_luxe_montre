{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "data/products.json",
      "use": "@vercel/static"
    },
    {
      "src": "assets/luxe-montre-storefront.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/admin.html",
      "dest": "/admin.html"
    },
    {
      "src": "/data/products.json",
      "dest": "/data/products.json"
    },
    {
      "src": "/assets/luxe-montre-storefront.jpg",
      "dest": "/assets/luxe-montre-storefront.jpg"
    }
  ]
}
