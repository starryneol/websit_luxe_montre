# Copy this file to .env and fill in your real key.
# Never paste the real key into index.html.
OPENAI_API_KEY=sk-your_openai_api_key_here

# Good default for a concierge/customer-service experience.
# You can change this later without touching the frontend.
OPENAI_MODEL=gpt-4.1-mini

# Local development port.
PORT=8080
